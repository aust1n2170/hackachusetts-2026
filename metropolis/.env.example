# Copy to .env (cp .env.example .env). Docker Compose sets DATABASE_URL for you.

# Road routing. Empty = straight-line estimate. With the routing profile: http://osrm:5000
OSRM_URL=

# Hospitals farther than this from the incident are not considered.
SEARCH_RADIUS_KM=60

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Feed jobs: simulate live ED feeds in development. Set false once real connectors exist.
SIMULATE_FEEDS=true
# Hospitals whose simulated feed is left alone so it goes stale (shows the fallback).
SIMULATE_STALE_IDS=seu
FEED_INTERVAL_SECONDS=60
